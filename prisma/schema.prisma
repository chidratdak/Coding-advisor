generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The transaction type is a plain string, validated in application code
// (see src/lib/actions.ts): INCOME | EXPENSE | SAVINGS.

// This app is single-user - no login, no accounts.
model SavingsGoal {
  id           String        @id @default(cuid())
  name         String
  category     String        @default("Emergency Fund")
  targetAmount Float
  currency     String        @default("USD")
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id        String       @id @default(cuid())
  type      String
  amount    Float
  currency  String       @default("USD")
  category  String
  note      String?
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  goalId    String?
  goal      SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([type])
  @@index([currency])
}
