generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The transaction type is a plain string, validated in application code
// (see src/lib/actions.ts): INCOME | EXPENSE | SAVINGS.

// Each row here is one person's account. The PIN is hashed with a random
// per-user salt (see src/lib/auth.ts) - this app supports any number of
// separate accounts, each seeing only their own data.
model User {
  id           String        @id @default(cuid())
  username     String        @unique
  pinHash      String
  pinSalt      String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  savingsGoals SavingsGoal[]
}

model SavingsGoal {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String        @default("Emergency Fund")
  targetAmount Float
  currency     String        @default("USD")
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  amount    Float
  currency  String       @default("USD")
  category  String
  note      String?
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  goalId    String?
  goal      SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([type])
  @@index([currency])
  @@index([userId])
}
